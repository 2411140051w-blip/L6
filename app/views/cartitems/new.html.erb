<h3>カートに追加</h3>
<p>商品名：<%= @product.name %></p>
<p>価格：<%= @product.price %></p>
<%= form_with model: @cartitem, url: cartitems_path do |f| %>
  <%= f.hidden_field :product_id, value: @product.id %>
  <p>
    <%= f.label :qty, '数量' %>
    <%= f.number_field :qty, min: 1 %>
  </p>
  <%= f.submit 'カートに追加' %>
<% end %>